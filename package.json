{
  "name": "kilo-gym",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "node --import tsx scripts/test-database.ts",
    "test:e2e": "playwright test",
    "db:local": "node --import tsx scripts/supabase-local.ts start",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "bootstrap": "node --import tsx scripts/bootstrap.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "test:e2e:smoke": "playwright test tests/e2e/public.spec.ts",
    "db:stop": "node --import tsx scripts/supabase-local.ts stop",
    "db:env": "node --import tsx scripts/local-env.ts",
    "db:status": "node --import tsx scripts/supabase-local.ts status"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "embedded-postgres": "^18.6.0-beta.19",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "type": "module"
}
